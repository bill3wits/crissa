#!/usr/bin/env python3
"""A stand-in systemd-run for the Control Panel tests (tests/test_crissa_panel*.py): it records the call in
$FAKE_SYSTEMD_STATE's "calls" as ["systemd-run", ...args] and runs nothing - a test that wants the timer to fire calls
the command itself. Never on a live machine's PATH: the tests put it first on their own subprocesses' PATH only."""
import fcntl
import json
import os
import sys

with open(os.environ["FAKE_SYSTEMD_STATE"], "r+") as fh:
    fcntl.flock(fh, fcntl.LOCK_EX)
    st = json.load(fh)
    st.setdefault("calls", []).append(["systemd-run"] + sys.argv[1:])
    fh.seek(0)
    fh.truncate()
    json.dump(st, fh, indent=1)
sys.exit(int(st.get("systemd_run_rc") or 0))
