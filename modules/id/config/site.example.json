{
  "schema": "house_site/v1",
  "site_id": "office-example",
  "display": "Example room (copied to site.json by the first run)",
  "notes": "Per-room config: devices for THIS room; the speak, presence and camera addresses come from this install's port table unless named here. Lives in the identity store (<state home>/identity/site.json); Init fills it in.",
  "audio": {
    "mic": "REPLACE_WITH_pactl_list_short_sources",
    "sink": null,
    "speak_url": null,
    "speak_voice": "announcer",
